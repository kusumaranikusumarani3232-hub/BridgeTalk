# AssemblyAI Realtime Speech-to-Text API Key (Required for live transcription)
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here

# Deployed translation provider (create a free Groq API key, then set it in Render)
TRANSLATION_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# Optional local translation provider for development
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b

# Server Configuration
HOST=0.0.0.0
PORT=8000
