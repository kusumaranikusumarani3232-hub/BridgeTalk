# AssemblyAI Realtime Speech-to-Text API Key (Required for live transcription)
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here

# Optional Translation Provider API Key (e.g. OpenAI GPT-3.5/4 for LLM translation)
# If left empty, BridgeTalk automatically uses free translator fallback
TRANSLATION_API_KEY=
TRANSLATION_PROVIDER=auto

# Server Configuration
HOST=0.0.0.0
PORT=8000
